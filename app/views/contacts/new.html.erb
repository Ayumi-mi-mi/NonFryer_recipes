<%= render "shared/header" %>

<body class="bg-white max-w-4xl mx-auto">
  <div class="flex items-center p-4 space-x-4">
    <%= render "shared/sidebar" %>
  </div>

  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold px-6 text-gray-600">お問い合わせ</h1>
  </div>

  <div class="px-6 py-1">
    <%= form_with url: contacts_path, local: true do |f| %>
      <div class="mt-6 space-y-2">
        <%= f.label :name, "お名前", class: "block" %>
        <%= f.text_field :name, class: "bg-white border border-gray-300 rounded-lg px-4 py-4 mb-1 w-full", required: true %>
      </div>
      <div class="mt-6 space-y-2">
        <%= f.label :email, "メールアドレス", class: "block" %>
        <%= f.email_field :email, class: "bg-white border border-gray-300 rounded-lg px-4 py-4 mb-1 w-full", required: true %>
      </div>
      <div class="mt-6 space-y-2">
        <%= f.label :message, "お問い合わせ内容", class: "block" %>
        <%= f.text_area :message, class: "bg-white border border-gray-300 rounded-lg px-4 mb-1 w-full h-64",  required: true %>
      </div>
      <hr class="border-t border-gray-500 border-2 my-8 px-6">
      <%= f.submit "送信", class: "btn w-full bg-amber-500 text-white rounded-lg px-4 mb-1 py-2" %>
    <% end %>
  </div>
</body>
