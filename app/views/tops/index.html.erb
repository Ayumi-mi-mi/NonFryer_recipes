<%= render "shared/header" %>

<body class="bg-white max-w-[1300px] mx-auto">
  <div class="flex p-4 space-x-4 w-full">
    <div class="flex-none">
      <%= render "shared/sidebar" %>
    </div>
    <div class="flex-1 flex justify-center">
      <%= search_form_for @q, url: root_path, method: :get, remote: true do |f| %>
        <div class="relative">
          <input type="text" id="autocomplete-input-tops"
            name="q[tags_name_or_title_cont_any]"
            placeholder="タグ, レシピ名から検索"
            class="flex-1 border border-gray-300 rounded px-4 py-1 w-64 md:w-[500px]"
            autocomplete="off"
            data-autocomplete-url="<%= autocomplete_tops_path %>">
          <ul id="autocomplete-results-tops"
            class="absolute bg-white border border-gray-300 rounded w-64 md:w-[500px] max-h-40 overflow-y-auto hidden z-30 text-xs">
          </ul>
          <%= f.submit "検索", class: "bg-amber-500 text-white rounded px-4 py-1" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @recipes.empty? %>
    <div class="text-center text-gray-500 mt-2">
      該当レシピがありませんでした
    </div>
  <% end %>

  <div class="grid grid-cols-2 md:grid-cols-5 gap-6 mx-[20px]">
    <% @recipes.each do |recipe| %>
      <div class="relative bg-orange-200 rounded w-full h-[130px] md:h-[160px]">
        <% if recipe.main_image.attached? %>
          <%= link_to image_tag(recipe.main_image, class: "w-full h-[130px] md:h-[160px] object-cover rounded" ), recipe_path(recipe) %>
        <% else %>
            <%= link_to "", recipe_path(recipe), class: "w-full h-[130px] md:h-[160px] flex items-center justify-center text-white font-bold" %>
        <% end %>
        <div class="absolute bottom-2 left-2 text-white font-bold text-sm">
          <%= link_to recipe.title, recipe_path(recipe) %>
        </div>
      </div>
    <% end %>
  </div>

  <script>
    document.addEventListener("turbo:load", function() {
      const input = document.getElementById("autocomplete-input-tops");
      const resultsList = document.getElementById("autocomplete-results-tops");
      const autocompleteUrl = input.dataset.autocompleteUrl;

      input.addEventListener("input", function() {
        const query = input.value.trim();
        if (query.length === 0) {
          resultsList.innerHTML = "";
          resultsList.classList.add("hidden");
          return;
        }

        fetch(`${autocompleteUrl}?q=${encodeURIComponent(query)}`)
          .then(response => response.json())
          .then(data => {
            resultsList.innerHTML = "";
            if (data.length === 0) {
              resultsList.classList.add("hidden");
              return;
            }

            data.forEach(item => {
              const li = document.createElement("li");
              li.textContent = item.label;
              li.classList.add("p-2", "hover:bg-gray-200", "cursor-pointer");

              li.addEventListener("click", function() {
                input.value = item.value;
                resultsList.innerHTML = "";
                resultsList.classList.add("hidden");
              });

              resultsList.appendChild(li);
            });

            resultsList.classList.remove("hidden");
          })
          .catch(error => console.error("Error fetching autocomplete results:", error));
      });

      document.addEventListener("click", function(event) {
        if (!input.contains(event.target) && !resultsList.contains(event.target)) {
          resultsList.classList.add("hidden");
        }
      });
    });
  </script>
</body>
