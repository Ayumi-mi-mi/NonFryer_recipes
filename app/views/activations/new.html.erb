<body class="bg-white max-w-2xl mx-auto">
  <div class="flex items-center p-6 space-x-4">
    <%= render "shared/sidebar" %>
  </div>
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold px-6 text-gray-600 mt-2">メールアドレス変更</h1>
  </div>
  <div class="px-6 py-6 text-gray-600">
    認証用URLが記載されたメールをお送りしますので、変更後のメールアドレスを入力してください。
  <div>

  <div class="py-1">
    <%= form_with url: activation_path(current_user), method: :patch do |f| %>
      <div class="mt-6 space-y-2">
        <%= f.label :email, class: "block text-sm text-gray-600" %>
        <%= f.email_field :email, required: true, class: "input input-bordered w-full" %>
      </div>
      <hr class="border-t border-gray-500 border-2 my-6 px-6">
      <%= f.submit "送信", class: "btn w-full bg-amber-500 text-white" %>
    <% end %>
  </div>
</body>
